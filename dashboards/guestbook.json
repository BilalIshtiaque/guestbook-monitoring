{
  "uid": "guestbook",
  "title": "Guestbook",
  "tags": ["guestbook"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(apache_up, namespace)", "refId": "namespace" },
        "definition": "label_values(apache_up, namespace)",
        "refresh": 1,
        "current": { "text": "default", "value": "default" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request rate",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(rate(apache_accesses_total{namespace=\"$namespace\"}[$__rate_interval]))" }]
    },
    {
      "id": 2, "type": "stat", "title": "Frontend pods up",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(apache_up{namespace=\"$namespace\"})" }]
    },
    {
      "id": 3, "type": "stat", "title": "Redis instances up",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 2 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(redis_up{namespace=\"$namespace\"})" }]
    },
    {
      "id": 4, "type": "stat", "title": "Redis replication",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [{ "type": "value", "options": { "0": { "text": "Broken", "color": "red" }, "1": { "text": "OK", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "min(redis_master_link_up{namespace=\"$namespace\"})" }]
    },
    {
      "id": 5, "type": "stat", "title": "Scrape targets down",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "count(up{namespace=\"$namespace\", container=\"metrics-exporter\"} == 0) or vector(0)" }]
    },
    {
      "id": 6, "type": "stat", "title": "Pod restarts (1h)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"(frontend|redis-leader|redis-replica)-.*\"}[1h])) or vector(0)" }]
    },

    { "id": 100, "type": "row", "title": "Traffic", "collapsed": false, "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 7, "type": "timeseries", "title": "Frontend request rate by pod",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (rate(apache_accesses_total{namespace=\"$namespace\"}[$__rate_interval]))", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Redis commands per second",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (service) (rate(redis_commands_processed_total{namespace=\"$namespace\"}[$__rate_interval]))", "legendFormat": "{{service}}" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Frontend busy workers by pod",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (apache_workers{namespace=\"$namespace\", state=\"busy\"})", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Redis connected clients",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (service) (redis_connected_clients{namespace=\"$namespace\"})", "legendFormat": "{{service}}" }]
    },

    { "id": 101, "type": "row", "title": "Errors & availability", "collapsed": false, "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 11, "type": "timeseries", "title": "Scrape target health (1 = up)",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1, "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "up{namespace=\"$namespace\", container=\"metrics-exporter\"}", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 12, "type": "timeseries", "title": "Container restarts (5m)",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "custom": { "fillOpacity": 10, "drawStyle": "bars" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"(frontend|redis-leader|redis-replica)-.*\"}[5m]))", "legendFormat": "{{pod}} / {{container}}" }]
    },
    {
      "id": 13, "type": "timeseries", "title": "Redis replication (leader replicas / replica link)",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 0, "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(redis_connected_slaves{namespace=\"$namespace\", service=\"redis-leader-metrics\"})", "legendFormat": "replicas connected to leader" },
        { "refId": "B", "expr": "min(redis_master_link_up{namespace=\"$namespace\"})", "legendFormat": "replica link up" }
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Redis rejected connections per second",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (service) (rate(redis_rejected_connections_total{namespace=\"$namespace\"}[$__rate_interval]))", "legendFormat": "{{service}}" }]
    },

    { "id": 102, "type": "row", "title": "Pod resource usage", "collapsed": false, "gridPos": { "x": 0, "y": 38, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 15, "type": "timeseries", "title": "CPU usage by pod",
      "gridPos": { "x": 0, "y": 39, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores", "decimals": 3, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container=\"\", pod=~\"(frontend|redis-leader|redis-replica)-.*\"}[$__rate_interval]))", "legendFormat": "{{pod}}" }]
    },
    {
      "id": 16, "type": "timeseries", "title": "Memory usage by pod",
      "gridPos": { "x": 12, "y": 39, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", container=\"\", pod=~\"(frontend|redis-leader|redis-replica)-.*\"})", "legendFormat": "{{pod}}" }]
    }
  ]
}
